{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_counts", "interval_ns", "intervals_per_case", "warmup_runs", "repeat_runs", "command_period_ns", "latitude_rad", "longitude_rad", "latitude_step_rad", "longitude_step_rad", "initial_heading_rad", "heading_step_rad", "initial_speed_mps", "initial_altitude_m", "heading_a_rad", "heading_b_rad", "speed_a_mps", "speed_b_mps", "altitude_a_m", "altitude_b_m"],
  "properties": {
    "entity_counts": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "integer", "minimum": 1, "maximum": 10000}},
    "interval_ns": {"type": "integer", "minimum": 1, "maximum": 2000000000},
    "intervals_per_case": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "integer", "minimum": 1, "maximum": 10000}},
    "warmup_runs": {"type": "integer", "minimum": 0, "maximum": 5},
    "repeat_runs": {"type": "integer", "minimum": 5, "maximum": 20},
    "command_period_ns": {"type": "integer", "minimum": 1, "maximum": 2000000000},
    "latitude_rad": {"type": "number", "minimum": -1.5707963267948966, "maximum": 1.5707963267948966},
    "longitude_rad": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793},
    "latitude_step_rad": {"type": "number", "minimum": -0.001, "maximum": 0.001},
    "longitude_step_rad": {"type": "number", "minimum": -0.001, "maximum": 0.001},
    "initial_heading_rad": {"type": "number"}, "heading_step_rad": {"type": "number", "minimum": -0.01, "maximum": 0.01},
    "initial_speed_mps": {"type": "number", "exclusiveMinimum": 0}, "initial_altitude_m": {"type": "number"},
    "heading_a_rad": {"type": "number"}, "heading_b_rad": {"type": "number"},
    "speed_a_mps": {"type": "number", "exclusiveMinimum": 0}, "speed_b_mps": {"type": "number", "exclusiveMinimum": 0},
    "altitude_a_m": {"type": "number"}, "altitude_b_m": {"type": "number"}
  }
}
