{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clock acceptance specimen; projection of SimTimeTick, not a new wire protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "events"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "tick"
        ],
        "properties": {
          "operation": {
            "enum": [
              "initialize",
              "announce",
              "restore"
            ]
          },
          "tick": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "timeline_epoch",
              "tick_id",
              "t_us",
              "dt_us",
              "paused",
              "advances_time",
              "scenario_epoch_utc"
            ],
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "timeline_epoch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "tick_id": {
                "type": "integer",
                "minimum": 0
              },
              "t_us": {
                "type": "integer",
                "minimum": 0
              },
              "dt_us": {
                "type": "integer",
                "minimum": 0
              },
              "paused": {
                "type": "boolean"
              },
              "advances_time": {
                "type": "boolean"
              },
              "scenario_epoch_utc": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
