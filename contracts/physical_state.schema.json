{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Physical-state contract specimen; not an additional runtime wire protocol",
  "description": "SI physical truth. Row-major body forward/right/down to ECEF rotation. Time is integer scenario nanoseconds; identities never use SoA slots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform_id",
    "dis_entity_id",
    "run_id",
    "timeline_epoch",
    "tick_id",
    "elapsed_ns",
    "position_ecef_m",
    "velocity_ecef_mps",
    "body_frd_to_ecef",
    "acceleration_ecef_mps2",
    "angular_velocity_body_radps"
  ],
  "properties": {
    "platform_id": {
      "type": "string",
      "minLength": 1
    },
    "dis_entity_id": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "timeline_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "tick_id": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "position_ecef_m": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "velocity_ecef_mps": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "body_frd_to_ecef": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "number"
      }
    },
    "acceleration_ecef_mps2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "angular_velocity_body_radps": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
